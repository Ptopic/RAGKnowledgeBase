# ============================================
# Server Configuration
# ============================================
PORT=8080
HOST=0.0.0.0

# ============================================
# Database Configuration (REQUIRED)
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_db

# ============================================
# Frontend & Backend URLs
# ============================================
NEXT_FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# ============================================
# Authentication Configuration (REQUIRED)
# ============================================
AUTH_TYPE=jwt
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
REGISTRATION_ENABLED=TRUE

# ============================================
# Google OAuth (Optional)
# ============================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/calendar/connector/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/gmail/connector/callback

# ============================================
# Airtable OAuth (Optional)
# ============================================
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
AIRTABLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/airtable/connector/callback

# ============================================
# Embedding Configuration
# ============================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MAX_SEQ_LENGTH=512
CHUNK_SIZE=512

# Azure OpenAI Embeddings (if using Azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# ============================================
# Reranker Configuration (Optional)
# ============================================
RERANKERS_ENABLED=FALSE
RERANKERS_MODEL_NAME=
RERANKERS_MODEL_TYPE=

# ============================================
# ETL Service Configuration
# Options: DOCLING, UNSTRUCTURED, LLAMACLOUD
# ============================================
ETL_SERVICE=DOCLING

# Unstructured API (if using UNSTRUCTURED)
UNSTRUCTURED_API_KEY=

# LlamaCloud API (if using LLAMACLOUD)
LLAMA_CLOUD_API_KEY=

# Firecrawl API (for web scraping)
FIRECRAWL_API_KEY=

# ============================================
# Text-to-Speech Configuration (Optional)
# ============================================
TTS_SERVICE=
TTS_SERVICE_API_BASE=
TTS_SERVICE_API_KEY=

# ============================================
# Speech-to-Text Configuration (Optional)
# ============================================
STT_SERVICE=
STT_SERVICE_API_BASE=
STT_SERVICE_API_KEY=

# ============================================
# Redis/Queue Configuration (for Celery -> Bull migration)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# LangSmith Observability (Optional)
# ============================================
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_TRACING_V2=FALSE

# ============================================
# Connector API Keys
# ============================================

# GitHub
GITHUB_TOKEN=

# Slack
SLACK_TOKEN=

# Notion
NOTION_TOKEN=

# Linear
LINEAR_API_KEY=

# Jira
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SERVER_URL=

# Confluence
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_BASE_URL=

# Discord
DISCORD_TOKEN=

# ClickUp
CLICKUP_API_KEY=

# Luma
LUMA_API_KEY=

# Elasticsearch
ELASTICSEARCH_HOST=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ============================================
# Search APIs (Optional)
# ============================================
TAVILY_API_KEY=
LINKUP_API_KEY=
SEARXNG_URL=
BAIDU_API_KEY=

# ============================================
# LLM Provider API Keys (Optional)
# These are for default/fallback LLMs
# User-specific LLMs are configured via LLMConfig in DB
# ============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
