# ============================================
# Server Configuration
# ============================================
PORT=8080
HOST=0.0.0.0

# ============================================
# Database Configuration (REQUIRED)
# ============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rag_db

# ============================================
# Frontend & Backend URLs
# ============================================
NEXT_FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
# API URL for webhooks (usually same as BACKEND_URL, but may differ in production)
API_URL=http://localhost:8080

# ============================================
# Authentication Configuration (REQUIRED)
# ============================================
AUTH_TYPE=jwt
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
REGISTRATION_ENABLED=TRUE

# ============================================
# Google OAuth (Optional)
# ============================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/auth/google/calendar/connector/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8080/auth/google/gmail/connector/callback

# ============================================
# Embedding Configuration
# ============================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MAX_SEQ_LENGTH=512
CHUNK_SIZE=512

# Azure OpenAI Embeddings (if using Azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# ============================================
# Reranker Configuration (Optional)
# ============================================
RERANKER_ENABLED=TRUE
RERANKER_NAME=jina-reranker-v1-base-en
RERANKER_TYPE=jina
RERANKER_API_KEY=

# ============================================
# ETL Service Configuration
# Options: DOCLING, UNSTRUCTURED, LLAMACLOUD
# ============================================
ETL_SERVICE=DOCLING

# Docling API (if using DOCLING)
# Run with: cd backend/docker/docling && docker-compose up -d
DOCLING_API_URL=http://localhost:5000
DOCLING_TIMEOUT=300000

# Unstructured API (if using UNSTRUCTURED)
UNSTRUCTURED_API_KEY=

# LlamaCloud API (if using LLAMACLOUD)
# Get API key from: https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_API_URL=https://api.cloud.llamaindex.ai/api/parsing
LLAMA_CLOUD_TIMEOUT=300000

# Jina Reader API (for web scraping - free to use, no API key needed)
# Uses https://r.jina.ai/{url} to convert any URL to LLM-friendly markdown
JINA_READER_ENABLED=TRUE
JINA_READER_API_KEY=
# Optional alias used in other projects (fallback if JINA_READER_API_KEY is empty)
JINA_API_KEY=
# Optional proxy routing for Jina Reader requests
JINA_READER_PROXY_ENABLED=FALSE
JINA_READER_PROXY_PROTOCOL=http
JINA_READER_PROXY_HOST=
JINA_READER_PROXY_PORT=9000
JINA_READER_PROXY_USERNAME=
JINA_READER_PROXY_PASSWORD=
# Optional: checks proxy exit IP via http://ip-api.com/json before each Jina request
JINA_READER_PROXY_CHECK_IP_ON_EACH_REQUEST=FALSE

# Optional Jina fallback via Crawlee + Impit (used only if Jina request fails)
JINA_READER_FALLBACK_CRAWLEE_ENABLED=TRUE
CRAWLEE_IMPIT_TIMEOUT_MS=45000
CRAWLEE_IMPIT_BROWSER=firefox
CRAWLEE_IMPIT_HTTP3=FALSE

# ============================================
# Text-to-Speech Configuration (Optional)
# ============================================
TTS_SERVICE=
TTS_SERVICE_API_BASE=
TTS_SERVICE_API_KEY=

# ============================================
# Speech-to-Text Configuration (Optional)
# Options: DEEPGRAM, local (not implemented)
# ============================================
STT_SERVICE=DEEPGRAM
STT_SERVICE_API_BASE=https://api.deepgram.com
STT_SERVICE_API_KEY=

# Deepgram Specific Configuration
# Get API key from: https://deepgram.com/
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en

# ============================================
# Redis/Queue Configuration (for Celery -> Bull migration)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# LangSmith Observability (Optional)
# ============================================
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=
LANGCHAIN_TRACING_V2=FALSE

# ============================================
# Connector API Keys
# ============================================

# GitHub
GITHUB_TOKEN=

# Slack
SLACK_TOKEN=

# Notion
NOTION_TOKEN=

# ============================================
# LLM Provider API Keys (Optional)
# These are for default/fallback LLMs
# User-specific LLMs are configured via LLMConfig in DB
# ============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=

# BrightData (for YouTube transcripts extraction)
# Get API key from: https://brightdata.com/
BRIGHTDATA_API_KEY=your_key_here
BRIGHTDATA_ZONE=youtube
