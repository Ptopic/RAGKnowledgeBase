# ─── RAGKnowledgeBase — Docker Compose Environment ────────────
# Copy to .env and fill in values before running docker compose up.
# All services use internal Docker networking (service names, not localhost).

# ═══ PostgreSQL ══════════════════════════════════════════════
POSTGRES_DB=rag_knowledge_base
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ═══ Auth (REQUIRED) ════════════════════════════════════════
AUTH_TYPE=email
SECRET_KEY=change-me-to-a-random-secret-key
JWT_SECRET=change-me-to-a-random-jwt-secret
REGISTRATION_ENABLED=TRUE

# ═══ API Key Encryption (REQUIRED for user provider API keys) ═══
API_ENCRYPTION_KEY=change-me-32-bytes-encryption-key

# ═══ URLs (update for your Coolify domain) ══════════════════
NEXT_PUBLIC_API_URL=https://your-coolify-domain.com
NEXT_PUBLIC_WEBSITE_URL=https://your-coolify-frontend-domain.com
NEXT_FRONTEND_URL=https://your-coolify-frontend-domain.com
BACKEND_URL=https://your-coolify-domain.com

# ═══ Email / Resend ══════════════════════════════════════════
RESEND_API_KEY=

# ═══ Google OAuth ════════════════════════════════════════════
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_GMAIL_REDIRECT_URI=

# ═══ LLM Provider Keys ══════════════════════════════════════
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ═══ Embedding / RAG ════════════════════════════════════════
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MAX_SEQ_LENGTH=512
CHUNK_SIZE=512
CHUNK_STRATEGY=markdown_aware
CHUNK_OVERLAP=120
CHUNK_MIN_CHARS=40

# ═══ Image Analysis ══════════════════════════════════════════
IMAGE_ENABLE_ANALYSIS=true
IMAGE_VISION_MODEL=google/gemini-3-flash-preview

# ═══ Reranker ════════════════════════════════════════════════
RERANKER_ENABLED=TRUE
RERANKER_NAME=jina-reranker-v1-base-en
RERANKER_TYPE=jina
RERANKER_API_KEY=

# ═══ ETL ═════════════════════════════════════════════════════
ETL_SERVICE=DOCLING
DOCLING_API_URL=http://localhost:5000

# ═══ Jina Reader ═════════════════════════════════════════════
JINA_READER_ENABLED=TRUE
JINA_READER_API_KEY=

# ═══ Connector API Keys ══════════════════════════════════════
GITHUB_TOKEN=
SLACK_TOKEN=
NOTION_TOKEN=

# ═══ S3 / Storage ═══════════════════════════════════════════
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_PUBLIC_URL_PREFIX=

# ═══ Observability ══════════════════════════════════════════
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=FALSE
