# ═══ LLM Provider Keys ═══
OPENAI_API_KEY=***
OPENROUTER_API_KEY=***

# ═══ Embedding / RAG ═══
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MAX_SEQ_LENGTH=512
CHUNK_SIZE=512
CHUNK_STRATEGY=markdown_aware
CHUNK_OVERLAP=120
CHUNK_MIN_CHARS=40

# ═══ Image Analysis ═══
IMAGE_ENABLE_ANALYSIS=true
IMAGE_VISION_MODEL=google/gemini-3-flash-preview

# ═══ Reranker ═══
RERANKER_ENABLED=TRUE
RERANKER_NAME=jina-reranker-v1-base-en
RERANKER_TYPE=jina
RERANKER_API_KEY=***

# ═══ ETL ═══
ETL_SERVICE=DOCLING
